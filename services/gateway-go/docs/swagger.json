{
    "swagger": "2.0",
    "info": {
        "description": "Recebe jobs, grava job + outbox e responde 202.",
        "title": "Gateway Go",
        "contact": {},
        "version": "1.0"
    },
    "basePath": "/",
    "paths": {
        "/jobs": {
            "post": {
                "description": "Grava o job e a outbox numa transação e responde 202. O processamento é assíncrono.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "jobs"
                ],
                "summary": "Cria um job",
                "parameters": [
                    {
                        "description": "Job",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.CreateJobRequest"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "$ref": "#/definitions/main.CreateJobResponse"
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/jobs/{id}": {
            "get": {
                "description": "Devolve o status e os resultados gravados pelos workers.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "jobs"
                ],
                "summary": "Consulta um job",
                "parameters": [
                    {
                        "type": "string",
                        "description": "ID do job (uuid)",
                        "name": "id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/main.JobView"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "schema": {
                            "$ref": "#/definitions/main.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.CreateJobRequest": {
            "type": "object",
            "required": [
                "type"
            ],
            "properties": {
                "payload": {
                    "type": "object",
                    "additionalProperties": {}
                },
                "type": {
                    "type": "string",
                    "example": "email.send"
                }
            }
        },
        "main.CreateJobResponse": {
            "type": "object",
            "properties": {
                "job_id": {
                    "type": "string",
                    "example": "7c9e6679-7425-40de-944b-e07fc1f90ae7"
                }
            }
        },
        "main.ErrorResponse": {
            "type": "object",
            "properties": {
                "detail": {
                    "type": "string"
                }
            }
        },
        "main.JobResult": {
            "type": "object",
            "properties": {
                "finished_at": {
                    "type": "string"
                },
                "result": {
                    "type": "object"
                },
                "worker": {
                    "type": "string"
                }
            }
        },
        "main.JobView": {
            "type": "object",
            "properties": {
                "created_at": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "origin": {
                    "type": "string"
                },
                "results": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/main.JobResult"
                    }
                },
                "status": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        }
    }
}